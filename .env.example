# Base URL of your Membrain instance's REST API v2 entry point.
# Replace "your-tenant" with your Membrain tenant subdomain.
MEMBRAIN_BASE_URL=https://your-tenant.membrain.com/API/v2/

# API key generated in Membrain (Settings > API Keys). Required.
MEMBRAIN_API_KEY=

# HTTP timeout in seconds for each request to the Membrain API.
MEMBRAIN_TIMEOUT_SECONDS=30

# Max retry attempts for idempotent requests (GET/PUT) on transient errors
# (connection errors, timeouts, HTTP 429/5xx). POST requests are never retried.
MEMBRAIN_MAX_RETRIES=3
